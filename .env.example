# --- Provider API Keys ---
# Fill in only the provider you want to use.
# The rest can stay empty.
#
# Recommended for beginners: Groq (free and fast)
# Get your key at: https://console.groq.com/keys

GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# --- Defaults ---
# Active provider on first launch
DEFAULT_PROVIDER=groq

# Default model if no model is selected in the project form
DEFAULT_MODEL=openai/gpt-oss-120b

# Max source text tokens (characters / 4)
MAX_SOURCE_TOKENS=6000

# Timeout per link (seconds)
CRAWL_TIMEOUT=20